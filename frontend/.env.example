# Frontend Environment Variables
# Copy this to .env.local for local dev, or set on Vercel dashboard for production

# The full API base URL (no trailing slash, include /api)
# Dev:        http://localhost:5000/api  ← this is the default fallback, no .env needed locally
# Production: https://your-backend.onrender.com/api
VITE_API_URL=https://your-backend.onrender.com/api
