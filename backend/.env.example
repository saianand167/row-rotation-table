# Backend Environment Variables
# Copy this to .env for local dev, or set on Render dashboard for production

# MongoDB connection string (required)
# Dev:        mongodb://127.0.0.1:27017/rrt
# Production: mongodb+srv://<user>:<pass>@cluster.mongodb.net/rrt?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOURUSER:YOURPASSWORD@cluster0.xxxxx.mongodb.net/rrt?retryWrites=true&w=majority

# Port (Render sets this automatically; leave as-is)
PORT=5000

# Allowed frontend origin(s) — comma-separated for multiple
# Dev:        http://localhost:3000
# Production: https://cse5-rrt.vercel.app
FRONTEND_URL=https://cse5-rrt.vercel.app

# Admin password — CHANGE THIS before going live!
ADMIN_PIN=ChangeMe_Str0ng#2025
