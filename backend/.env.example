# Backend Environment Variables
# Set these in your hosting service dashboard (Render, Railway, Heroku, etc.)

# Port (Hosting services set this automatically, fallback: 5000)
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://username:password@cluster.mongodb.net/rrt?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/rrt

# CORS Allowed Origins (Comma separated list of frontend URLs)
# Example: https://cse5-rrt.vercel.app,http://localhost:3000
FRONTEND_URL=https://cse5-rrt.vercel.app,http://localhost:3000

# Admin Authentication PIN (Default: CSE5@123)
ADMIN_PIN=CSE5@123

# Web Push VAPID Configuration (Optional - auto-generated if left blank)
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_MAILTO=mailto:admin@cse5rrt.local
